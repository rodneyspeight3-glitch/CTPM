# Node does not automatically read this file. Supply real values securely
# through Render Environment settings; never commit an actual .env file.
NODE_ENV=production
DATABASE_PATH=/var/data/ctpm/app.sqlite
# Set both on the first start of an empty database. No default password exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional canonical URL, e.g. https://your-existing-service.onrender.com
# If omitted, same-origin checks use the request host.
APP_ORIGIN=

# Keep external email and fee-based checkout disabled for the free handover.
ALLOW_PAID_INTEGRATIONS=false
